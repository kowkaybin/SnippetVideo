{
  "name": "snippetvideo",
  "version": "0.1.0",
  "private": true,
  "description": "Chromium extension for silent screen recording with a toolbar start/stop flow.",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "build": "npm run icons && vite build",
    "icons": "node scripts/make-icons.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test && npm run build && npm run smoke",
    "smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.8",
    "@types/node": "^26.4.1",
    "playwright-core": "^1.63.0",
    "typescript": "^5.9.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "fix-webm-duration": "^1.0.6"
  }
}
